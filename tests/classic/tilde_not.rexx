/* ~ is NOT in classic Regina; all of this must keep working */
a = 1; b = 0
say ~a ~b
say ~ a
say a ~b
say "x" ~b
say a ~= b a ~== b a ~< b
say a ~> b
say a ~>> b
say a ~<< b
say a~=b
say a~==b
say a~<b
say a~>b
say a~>>b
say a~<<b
say (a)~=b
say "x"~=b
say a.~=b
say a~ =b
say a~ <b
say a~=b a~==b
say (a~=b) (a~==b)
say ~(a & b)
say \a ^b
if ~b then say 'not b'
x = ~ ~ a; say x
say 1 ~=1
say 'abc' ~== 'abc'
say a ~ = b
say a ~ < b
